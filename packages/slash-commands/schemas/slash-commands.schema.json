{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skills-fabrik.com/schemas/slash-commands.schema.json",
  "title": "Slash Commands Registry Schema",
  "description": "Schema for slash command registry definitions",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Registry version following semantic versioning"
    },
    "commands": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9-_]*$": {
          "$ref": "#/definitions/slashCommand"
        }
      },
      "additionalProperties": false,
      "description": "Command registry indexed by command name"
    },
    "categories": {
      "type": "object",
      "properties": {
        "dev-docs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Development documentation commands"
        },
        "quality": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Code quality and review commands"
        },
        "testing": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Testing and validation commands"
        },
        "utilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Utility and helper commands"
        }
      },
      "required": ["dev-docs", "quality", "testing", "utilities"],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9-_]*$": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-_]*$"
        }
      },
      "additionalProperties": false,
      "description": "Command aliases mapping alias to command name"
    }
  },
  "required": ["version", "commands", "categories", "aliases"],
  "additionalProperties": false,
  "definitions": {
    "slashCommand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-_]*$",
          "minLength": 1,
          "maxLength": 50,
          "description": "Command name without the slash prefix"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "description": "Human-readable description of what the command does"
        },
        "category": {
          "enum": ["dev-docs", "quality", "testing", "utilities"],
          "description": "Command category for organization"
        },
        "handler": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-_]*\\.ts$",
          "description": "Handler module filename"
        },
        "requiresAuth": {
          "type": "boolean",
          "description": "Whether the command requires authentication"
        },
        "persistenceLevel": {
          "enum": ["none", "session", "permanent"],
          "description": "Level of context persistence required"
        },
        "integration": {
          "$ref": "#/definitions/commandIntegration",
          "description": "Integration details for external systems"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-_]*$"
          },
          "uniqueItems": true,
          "description": "Alternative names for the command"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/.*",
            "minLength": 2
          },
          "uniqueItems": true,
          "description": "Example usage of the command"
        }
      },
      "required": ["name", "description", "category", "handler", "requiresAuth", "persistenceLevel"],
      "additionalProperties": false
    },
    "commandIntegration": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-_]*$",
          "description": "ID of the skill to integrate with"
        },
        "daemonEndpoint": {
          "type": "string",
          "pattern": "^/[a-zA-Z][a-zA-Z0-9-_]*$",
          "description": "Daemon API endpoint path"
        },
        "cliCommand": {
          "type": "string",
          "description": "CLI command to execute"
        },
        "memTechL1": {
          "type": "boolean",
          "description": "Whether to use MemTech L1 storage"
        }
      },
      "additionalProperties": false
    }
  }
}