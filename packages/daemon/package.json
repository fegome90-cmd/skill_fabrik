{
  "name": "@skills-fabrik/daemon",
  "version": "2.0.0",
  "description": "Skill Fabric Daemon V2 - Enhanced orchestration with PM2 clustering, graceful shutdown, and health monitoring",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:v2": "tsc --project tsconfig.v2.json",
    "start": "node dist/index.js",
    "start:v2": "node dist/daemon-v2.js",
    "dev": "tsc --watch",
    "dev:v2": "tsc --project tsconfig.v2.json --watch",
    "cluster:start": "pm2 start ecosystem.config.js",
    "cluster:stop": "pm2 stop skills-daemon",
    "cluster:restart": "pm2 restart skills-daemon",
    "cluster:delete": "pm2 delete skills-daemon",
    "cluster:monitor": "pm2 monit",
    "cluster:logs": "pm2 logs skills-daemon",
    "health:check": "node -e \"require('./dist/health-check-system.js').performHealthCheck()\"",
    "test:v2": "vitest run __tests__/daemon-v2.test.ts",
    "test:v2:watch": "vitest watch __tests__/daemon-v2.test.ts",
    "test:v2:coverage": "vitest run --coverage __tests__/daemon-v2.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@skills-fabrik/kpi": "workspace:*",
    "@skills-fabrik/router": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.38.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pm2": "^6.0.13",
    "pg": "^8.12.0",
    "prettier": "^3.1.1",
    "prom-client": "^15.1.3",
    "ws": "^8.18.3",
    "yaml": "^2.4.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.7",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.6.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4"
  }
}
