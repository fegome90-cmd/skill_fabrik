{
  "name": "@skills-fabrik/adr-service",
  "version": "1.0.0",
  "description": "ACE-ADR Integration Service for Skills Fabric",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "analyze:conversation": "tsx src/detector/complexity-detector.ts --analyze",
    "test:health": "tsx scripts/test-health.ts",
    "test:analyze": "tsx scripts/test-analyze.ts"
  },
  "dependencies": {
    "fastify": "^4.24.3",
    "@fastify/cors": "^8.4.0",
    "@fastify/swagger": "^8.12.0",
    "zod": "^3.22.4",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "adr",
    "ace",
    "skills",
    "architecture",
    "decision-records"
  ],
  "author": "Skills Fabric Team",
  "license": "MIT"
}
