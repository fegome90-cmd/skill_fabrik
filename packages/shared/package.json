    "microservices"
  ],
  "author": "Skills Fabric Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "cors": "link:@types/@fastify/cors",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist/**/*",
    "README.md"
