{
  "name": "@skills-fabrik/shared",
  "version": "1.0.0",
  "description": "Shared utilities for Skills Fabric services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "node --watch dist/index.js",
