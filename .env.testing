# Skills Fabrik Environment Configuration

# Daemon Configuration
SF_HOST=127.0.0.1
SF_PORT=7727
SF_ENDPOINT=http://127.0.0.1:7727
SF_LOG_LEVEL=info
SF_STORAGE_L0=.sf
SF_STORAGE_L1=.sf/cache
CONFIRM_SECRET=change_me_with_a_random_32_char_secret

# Database Configuration (L2 - Postgres-first)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sf_user
PG_PASSWORD=sf_pass
PG_DATABASE=sf_db

# Alternative/Development Database
PG_HOST_DEV=127.0.0.1
PG_PORT_DEV=5433
PG_USER_DEV=surprise_user
PG_PASSWORD_DEV=staging_surprise_password_2025
PG_DATABASE_DEV=surprise_metrics_staging

# Redis Configuration (Future caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Router Configuration
PORT=3000
DAEMON_URL=http://127.0.0.1:7727

# PM2 Configuration
PM2_HOME=.pm2
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z

# Monitoring & Metrics
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=5000

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Mode
CLI_MODE=service

# Optional Features (disabled by default)
MEMTECH_REDIS_ENABLED=false
MEMTECH_CHROMA_ENABLED=false

# Cache Configuration
SF_CACHE_MAX_SIZE=1000
SF_CACHE_TTL=60000
SF_CACHE_CLEANUP_INTERVAL=30000

# File Watching Configuration
SF_WATCH_PATHS=./skills:./packages:./src
SF_WATCH_DEBOUNCE_MS=1000

# Error Handling Configuration
SF_LOG_SILENT_ERRORS=false
SF_ERROR_METRICS_ENABLED=true

# Memory Management
SF_MEMORY_LIMIT_MB=512
SF_MEMORY_CHECK_INTERVAL=60000
# Database Configuration for Testing
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sf_user
PG_PASSWORD=sf_pass
PG_DATABASE=sf_db
