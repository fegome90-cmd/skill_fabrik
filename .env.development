# Skills Fabrik Development Environment

# Daemon Configuration
SF_HOST=127.0.0.1
SF_PORT=7727
SF_ENDPOINT=http://127.0.0.1:7727
SF_LOG_LEVEL=info
SF_STORAGE_L0=.sf
SF_STORAGE_L1=.sf/cache
CONFIRM_SECRET=dev_secret_change_me_in_production

# Database Configuration (Development)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sf_user
PG_PASSWORD=sf_pass
PG_DATABASE=sf_db

# Redis Configuration (Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Router Configuration
PORT=3000
DAEMON_URL=http://127.0.0.1:7727

# PM2 Configuration
PM2_HOME=.pm2
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z

# Monitoring & Metrics
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=5000

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Mode
CLI_MODE=service

# Optional Features (disabled by default)
MEMTECH_REDIS_ENABLED=false
MEMTECH_CHROMA_ENABLED=false