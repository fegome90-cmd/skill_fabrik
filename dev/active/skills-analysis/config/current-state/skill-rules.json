  "database-verification": {
    "type": "guideline",
    "enforcement": "suggest",
    "priority": "medium",
    "promptTriggers": {
      "keywords": [
        "aplica",
        "bloqueo",
        "mutaciones",
        "masivas",
        "filtro",
        "previene",
        "operaciones",
        "destructivas",
        "inseguras."
      ],
      "intentPatterns": [
        "(query|consulta|operaci[oó]n|mutaci[oó]n|update|delete|insert).*(masiv[oa]|bulk|riesgo|peligros[ao]|sin\\s+where)",
        "(revisar|auditar).*(findMany|updateMany|deleteMany)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/{repositories,repos,db,prisma,migrations}/**/*.{ts,js,sql}"
      ],
      "contentPatterns": [
        "(findMany|updateMany|deleteMany)\\(",
        "pool\\.query|client\\.query",
        "DELETE\\s+FROM\\s+\\w+"
      ]
    }
  },
  "secrets-and-config": {
    "type": "guideline",
    "enforcement": "suggest",
    "priority": "medium",
    "promptTriggers": {
      "keywords": [
        "secretos",
        "embebidos;",
        "validar",
        "config",
        "arranque",
        "mantener",
        ".env.example."
      ],
      "intentPatterns": [
        "(secreto|secret|credencial|credential|token|api\\s*key|config|\\.env|variable\\s+de\\s+entorno)",
        "revisar.*(PASSWORD|SECRET|API[_-]?KEY|TOKEN)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/.env*",
        "**/config/**",
        "**/*config*.{ts,js,json}"
      ],
      "contentPatterns": [
        "(PASSWORD|SECRET|API[_-]?KEY|TOKEN|AUTH[_-]?TOKEN)"
      ]
    }
  },
  "backend-dev-guidelines": {
    "type": "guideline",
    "enforcement": "suggest",
    "priority": "medium",
    "promptTriggers": {
      "keywords": [
        "patrones",
        "backend",
        "para",
        "crear",
        "endpoints,",
        "apis",
        "servicios.",
        "guía",
        "rutas→controladores→servicios→repositorios,",
        "manejo"
      ],
      "intentPatterns": [
        "(crear|agregar|añadir|implementar|fix|refactor).*?(endpoint|ruta|route|controller|controlador|service|servicio|api)",
        "(autenticaci[oó]n|auth|login|registro|signup).*(ruta|endpoint|controller|servicio)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/{controllers,routes,services}/**/*.{ts,js,tsx}",
        "backend/src/**/*",
        "packages/**/{controllers,routes,services}/**/*.{ts,js}"
      ],
      "contentPatterns": [
        "router\\.(get|post|put|delete)\\(",
        "export\\s+(class|const)\\s+\\w+Controller",
        "express\\.(Router|router)\\("
      ]
    }
  },
  "frontend-dev-guidelines": {
    "type": "guideline",
    "enforcement": "suggest",
    "priority": "medium",
    "promptTriggers": {
      "keywords": [
        "patrones",
        "frontend",
        "para",
        "crear",
        "componentes",
        "react,",
        "interfaces.",
        "guía",
        "puros,",
        "fetching"
      ],
      "intentPatterns": [
        "(crear|agregar|añadir|implementar|fix|refactor).*?(componente|component|hook|vista|view|ui)",
        "(dashboard|lista|tabla|card|formulario).*(react|componente|hook)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/components/**/*.{ts,tsx}",
        "frontend/src/**/*.{ts,tsx}",
        "packages/**/src/**/components/**/*.{ts,tsx}"
      ],
      "contentPatterns": [
        "function\\s+[A-Z]\\w+\\(",
        "use[A-Z]\\w+\\(",
        "export\\s+default\\s+function\\s+[A-Z]\\w+"
      ]
    }
  },
