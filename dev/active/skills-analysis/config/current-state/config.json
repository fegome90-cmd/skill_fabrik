{
  "version": "1.0.0",
  "description": "Universal Hook Configuration for Skills Fabric",
  "hooks": {
    "pre-invoke": {
      "script": "./pre-invoke.mjs",
      "description": "Universal pre-invoke hook for skill activation",
      "default_mode": "auto",
      "timeout_ms": 5000,
      "retry_attempts": 2,
      "fallback_modes": ["direct", "http", "cli"]
    },
    "stop": {
      "script": "./stop.mjs",
      "description": "Universal stop hook for post-processing",
      "default_mode": "auto",
      "timeout_ms": 10000,
      "retry_attempts": 1,
      "fallback_modes": ["direct", "http", "cli"]
    }
  },
  "modes": {
    "auto": {
      "description": "Automatically select best available mode",
      "priority": ["direct", "http", "cli"]
    },
    "direct": {
      "description": "Direct Node import - fastest mode",
      "requirements": ["router package available"],
      "advantages": ["lowest latency", "no network overhead"],
      "disadvantages": ["requires router dependencies"]
    },
    "http": {
      "description": "HTTP daemon mode - enhanced capabilities",
      "requirements": ["daemon running on port 3000"],
      "advantages": ["daemon-enhanced", "caching", "distributed"],
      "disadvantages": ["network latency", "daemon dependency"]
    },
    "cli": {
      "description": "CLI fallback mode - always available",
      "requirements": ["skills-cli available"],
      "advantages": ["always works", "no dependencies"],
      "disadvantages": ["limited functionality", "higher latency"]
    }
  },
  "environment": {
    "ROUTER_URL": {
      "description": "Router service URL for HTTP mode",
      "default": "http://127.0.0.1:3000",
      "required_for": ["http"]
    },
    "SF_HOOKS_VERBOSE": {
      "description": "Enable verbose logging",
      "default": "false",
      "type": "boolean"
    },
    "SF_HOOKS_TIMEOUT": {
      "description": "Default timeout for hook execution",
      "default": "5000",
      "type": "number"
    },
    "SF_HOOKS_MODE": {
      "description": "Force specific execution mode",
      "default": "auto",
      "options": ["auto", "direct", "http", "cli"]
    }
  },
  "integration": {
    "cursor": {
      "preInvokeCommand": "node scripts/hooks/pre-invoke.mjs --prompt \"$PROMPT\" --open-files \"$OPEN_FILES\" --active-file-content \"$ACTIVE_FILE_CONTENT\" --cwd \"$CWD\"",
      "stopCommand": "node scripts/hooks/stop.mjs --auto-git-diff --cwd \"$CWD\"",
      "configuration": ".cursor/hooks/hooks-config.json"
    },
    "vscode": {
      "preInvokeCommand": "node scripts/hooks/pre-invoke.mjs --prompt \"$INPUT\" --cwd \"$WORKSPACE_FOLDER\"",
      "stopCommand": "node scripts/hooks/stop.mjs --auto-git-diff --cwd \"$WORKSPACE_FOLDER\"",
      "extension": "skills-fabric.vscode-extension"
    },
    "jetbrains": {
      "preInvokeCommand": "node scripts/hooks/pre-invoke.mjs --prompt \"$Text$\" --cwd \"$ProjectFileDir$\"",
      "stopCommand": "node scripts/hooks/stop.mjs --auto-git-diff --cwd \"$ProjectFileDir$\"",
      "plugin": "skills-fabric-jetbrains"
    },
    "cli": {
      "preInvokeCommand": "node scripts/hooks/pre-invoke.mjs --prompt \"$1\"",
      "stopCommand": "node scripts/hooks/stop.mjs --auto-git-diff",
      "wrapper": "sf-hook"
    }
  },
  "troubleshooting": {
    "common_issues": [
      {
        "problem": "Hook fails with 'module not found'",
        "solution": "Ensure dependencies are installed: pnpm install",
        "mode_fallback": "Try using --mode cli"
      },
      {
        "problem": "HTTP mode fails with connection refused",
        "solution": "Start router service: pm2 start scripts/pm2/ecosystem.config.cjs --only router-service",
        "mode_fallback": "Try using --mode direct or --mode cli"
      },
      {
        "problem": "Direct mode fails with router import error",
        "solution": "Build router package: pnpm --filter @skills-fabrik/router build",
        "mode_fallback": "Try using --mode http or --mode cli"
      },
      {
        "problem": "Hooks running but no skills activated",
        "solution": "Check skills registry: node packages/skills-cli/dist/index.js skills index ./skills",
        "additional": "Verify prompt contains skill keywords"
      }
    ],
    "debug_mode": {
      "enable": "SF_HOOKS_VERBOSE=true",
      "environment": "export SF_HOOKS_VERBOSE=true",
      "command_line": "--verbose"
    }
  },
  "monitoring": {
    "metrics": {
      "execution_time": "Track hook execution latency",
      "success_rate": "Monitor hook success/failure rates",
      "mode_usage": "Track which modes are being used",
      "skill_activations": "Count skill activation requests"
    },
    "logging": {
      "level": "info",
      "format": "json",
      "destination": "stderr"
    }
  }
}