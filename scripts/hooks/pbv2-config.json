{"_comment": "Configuración centralizada para integración PBv2 con Claude Code hooks", "version": "2.0.0", "updated": "2025-11-03", "detection": {"enabled": true, "patterns": {"strong": ["/\\[Layout\\]/i", "/Clarify.*Layout.*Operate/i", "/\\[\\w+\\].*Plan/i"], "contextual": ["^## Plan/i", "^### Objetivos/i"]}, "minStructure": {"minBulletPoints": 2, "requireCLOOP": false}, "cache": {"enabled": true, "maxSize": 100, "ttlMinutes": 60}}, "activation": {"enabled": true, "mode": "auto", "availableModes": {"logOnly": {"description": "Solo detecta y guarda, sin mostrar UI", "default": false}, "onDemand": {"description": "Pregunta al usuario antes de activar", "default": false}, "auto": {"description": "Activa automáticamente (ideal para hooks)", "default": true}}, "debounceMs": 2000}, "pbv2": {"defaultComplexity": "medium", "includeFiles": "auto", "includeTemplate": true, "includeTags": true, "timeoutMs": 5000, "fastMode": {"enabled": true, "repoSizeThreshold": "medium"}}, "output": {"saveToDevPlans": true, "savePath": "dev/plans/auto-plan-{id}-{timestamp}.json", "showInTerminal": true, "terminalFormat": "compact", "compactMessage": "🧩 Plan detectado y prompt generado - Ver dev/plans/"}, "cache": {"enabled": true, "maxSize": 100, "cleanupInterval": 24}, "metrics": {"enabled": true, "trackLatency": true, "trackSuccess": true, "trackErrors": true, "logFile": "logs/pbv2-integration.log"}, "fallback": {"onError": "logOnly", "maxRetries": 0, "retryDelayMs": 1000}, "development": {"debugMode": false, "verboseLogging": false, "testMode": false}}