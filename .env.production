# Skills Fabrik Production Environment

# Daemon Configuration
SF_HOST=0.0.0.0
SF_PORT=7727
SF_ENDPOINT=http://0.0.0.0:7727
SF_LOG_LEVEL=warn
SF_STORAGE_L0=/var/lib/skills-fabrik/cache
SF_STORAGE_L1=/var/lib/skills-fabrik/cache
CONFIRM_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_SECRET

# Database Configuration (Production)
PG_HOST=localhost
PG_PORT=5432
PG_USER=sf_prod_user
PG_PASSWORD=CHANGE_ME_PROD_PASSWORD
PG_DATABASE=sf_prod_db

# Redis Configuration (Production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Router Configuration
PORT=3000
DAEMON_URL=http://sf-daemon:7727

# PM2 Configuration
PM2_HOME=/var/lib/skills-fabrik/pm2
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z

# Monitoring & Metrics
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=3000

# Environment
NODE_ENV=production
LOG_LEVEL=warn

# Service Mode
CLI_MODE=service

# Optional Features (disabled by default)
MEMTECH_REDIS_ENABLED=false
MEMTECH_CHROMA_ENABLED=false