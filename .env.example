# Skills Fabric MCP - Variables de Entorno
# Copia este archivo como .env y configura los valores

# ==============================================
# REDIS CONFIGURATION
# ==============================================

# Redis Cache (L0) - Puerto 6380
# Para almacenamiento ultrarrápido de datos críticos
REDIS_CACHE_URL=redis://localhost:6380

# Redis Core (L1) - Puerto 6381
# Para snapshots de planes y memoria de trabajo
REDIS_CORE_URL=redis://localhost:6381
MEMTECH_REDIS_CORE_HOST=localhost
MEMTECH_REDIS_CORE_PORT=6381
MEMTECH_REDIS_CORE_PASSWORD=

# ==============================================
# POSTGRESQL CONFIGURATION (L2)
# ==============================================

# Para memoria de contexto estructurada
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=mcp_password
PG_DATABASE=surprise_metrics

# ==============================================
# CHROMADB CONFIGURATION (L3) - OPCIONAL
# ==============================================

# Para memoria a largo plazo con búsqueda semántica
# Nota: ChromaDB está deshabilitado por defecto
# Requiere ChromaDB Cloud o self-hosted instance

# Si usas ChromaDB Cloud:
CHROMA_API_KEY=tu_chroma_api_key
CHROMA_TENANT=tu_tenant
CHROMA_DATABASE=memtech
CHROMA_COLLECTION=memtech_memory

# Si usas ChromaDB self-hosted:
# CHROMA_URL=http://localhost:8000
# CHROMA_AUTH_PROVIDER=none

# ==============================================
# MCP SERVER CONFIGURATION
# ==============================================

# Transport para MCP (stdio | websocket)
MCP_TRANSPORT=stdio

# Puerto para WebSocket (cuando transport=websocket)
MCP_WEBSOCKET_PORT=3001

# ==============================================
# SKILLS FABRIC INTEGRATION
# ==============================================

# URLs de servicios Skills Fabric (si están ejecutándose)
SKILLS_ROUTER_URL=http://localhost:3000
SKILLS_DAEMON_URL=http://localhost:7727
SKILLS_DISCOVERY_URL=http://localhost:8877

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================

# Nivel de logs (error | warn | info | debug)
LOG_LEVEL=info

# Modo de desarrollo
NODE_ENV=development

# Habilitar métricas detalladas
MEMTECH_VERBOSE=false

# ==============================================
# SECURITY SETTINGS
# ==============================================

# Tokens para servicios externos (si aplica)
# EXTERNAL_API_TOKEN=tu_token

# ==============================================
# PERFORMANCE SETTINGS
# ==============================================

# Pool de conexiones para PostgreSQL
PG_POOL_MIN=2
PG_POOL_MAX=10

# TTL para cache Redis (en segundos)
REDIS_TTL=86400

# Timeout para operaciones (en ms)
OPERATION_TIMEOUT=30000

# ==============================================
# TESTING SETTINGS
# ==============================================

# URLs para testing local
TEST_DB_URL=postgresql://postgres:mcp_password@localhost:5433/surprise_metrics
TEST_REDIS_URL=redis://localhost:6381

# ==============================================
# NOTES
# ==============================================

# 1. Cambia todas las contraseñas por defecto
# 2. Si no tienes ChromaDB, deja esas variables vacías
# 3. Los puertos 6380, 6381, 5433 deben estar libres
# 4. Para ChromaDB self-hosted, instala y ejecuta por separado
