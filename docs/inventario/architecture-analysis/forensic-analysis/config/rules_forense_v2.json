  "validation": {
    "rules_check": {
      "id": "VAL-001",
      "command": "node scripts/validate-rules.js",
      "frequency": "antes de cada fase",
      "required": true,
      "timeout_ms": 10000,
      "test_file": "tests/validation/rules-check.test.js"
    },
    "evidence_check": {
      "id": "VAL-002",
      "command": "node scripts/validate-evidence.js",
      "frequency": "después de cada informe",
      "required": true,
      "timeout_ms": 15000,
      "test_file": "tests/validation/evidence-check.test.js"
    },
    "completeness_check": {
      "id": "VAL-003",
      "command": "node scripts/validate-completeness.js",
      "frequency": "al final de cada fase",
      "required": true,
      "timeout_ms": 10000,
      "test_file": "tests/validation/completeness-check.test.js"
    },
    "data_integrity_check": {
      "id": "VAL-004",
      "command": "node scripts/validate-data-integrity.js",
      "frequency": "después de correcciones de datos + continuo en CI",
      "required": true,
      "timeout_ms": 20000,
      "test_file": "tests/validation/data-integrity-check.test.js",
      "checks": [
        "Cross-check métricas componentes entre todas las fases",
        "Verificar conteos de archivos con find/wc",
        "Validar configuraciones ESLint funcionales",
        "Detectar caracteres no-ASCII en documentación",
        "Validar checksums de archivos originales"
      ]
    },
    "tdd_compliance_check": {
      "id": "VAL-005",
      "command": "node scripts/validate-tdd-compliance.js",
      "frequency": "con cada nuevo script o regla",
      "required": true,
      "timeout_ms": 15000,
      "test_file": "tests/validation/tdd-compliance-check.test.js",
      "checks": [
        "Cada regla tiene test automatizado",
        "Tests escritos antes de implementación",
        "Coverage > 80% en validadores",
        "Tests previenen regresiones"
      ]
    },
    "continuous_validation": {
      "id": "VAL-006",
      "command": "node scripts/continuous-validation.js",
      "frequency": "en cada commit (CI/CD)",
