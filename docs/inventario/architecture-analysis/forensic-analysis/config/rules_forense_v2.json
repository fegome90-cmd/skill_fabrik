      "maximas": ["gobernanza", "evidencia", "consistencia"],
      "prohibiciones": ["PROH-002", "PROH-009"],
      "obligaciones": ["OBL-003", "OBL-008"],
      "quality_gates": ["QG-005", "QG-006", "QG-007"],
