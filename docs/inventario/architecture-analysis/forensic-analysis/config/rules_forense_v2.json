      "resolution": "completar evidencia + validar reproducibilidad"
    },
    "data_inconsistency": {
      "action": "pausar análisis - reconciliar datos",
      "escalation": "cross-check con múltiples fuentes",
      "resolution": "establecer fuente única de verdad + actualizar todos los informes"
    },
    "test_failure": {
      "action": "bloqueador - no continuar hasta resolver",
      "escalation": "analizar causa raíz + documentar en lecciones aprendidas",
