  "emergency": {
    "rule_violation": {
      "action": "detener inmediatamente la fase actual",
      "escalation": "reportar a dev-docs/tasks.md + notificar equipo",
      "resolution": "corregir antes de continuar",
      "rollback": "restaurar estado anterior si es necesario",
      "test_verification": "ejecutar tests de regresión después de corrección"
    },
    "quality_gate_failure": {
      "action": "no avanzar a la siguiente fase - bloqueador",
      "escalation": "registrar fallo en log + generar reporte detallado",
      "resolution": "resolver todos los errores + re-ejecutar gate",
      "retry_policy": {
        "max_retries": 3,
        "backoff_ms": 5000
      }
    },
    "evidence_missing": {
      "action": "marcar informe como incompleto - no publicar",
