{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parser": "espree",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [],
  "ignorePatterns": [
    "*.md",
    "*.json",
    "consolidated-reports/",
    "dev-docs/",
    "archive/",
    "docs/",
    "node_modules/"
  ],
  "rules": {
    "indent": ["warn", 2, { "SwitchCase": 1 }],
    "linebreak-style": ["warn", "unix"],
    "quotes": ["warn", "single"],
    "semi": ["warn", "always"],
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-debugger": "off",
    "no-trailing-spaces": "warn",
    "eol-last": "warn",
    "comma-dangle": "off",
    "object-curly-spacing": "off",
    "array-bracket-spacing": "off",
    "no-useless-escape": "off",

    "no-multiple-empty-lines": "warn",
    "no-irregular-whitespace": "error",
    "no-control-regex": "error"
  },
  "overrides": [
    {
      "files": ["*.md"],
      "rules": {
        "no-irregular-whitespace": "error"
      }
    }
  ]
}
