{
  "name": "refactor-preparation-skills-fabrik",
  "version": "1.0.0",
  "description": "Preparación y planificación para la refactorización del sistema Skills Fabrik basada en análisis forense V2.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src/ tests/ --ext .js --max-warnings=20",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:refactor": "node config/validate-rules.js config/rules_refact.json",
    "validate:preparation": "node src/validation/preparation-validator.js",
    "validate:gates": "node src/validation/gates-checker.js",
    "validate:quality": "npm run lint && npm run format:check && npm run test -- --passWithNoTests",
    "validate:full": "npm run validate:quality && npm run validate:refactor && npm run validate:preparation",
    "phase:1-start": "npm run validate:full && echo 'Phase 1: Analysis & Planning - Ready to Start'",
    "phase:1-analyze": "node src/planning/impact-analyzer.js",
    "phase:1-deps": "node src/planning/dependency-mapper.js",
    "phase:1-risk": "node src/planning/risk-assessor.js",
    "phase:1-effort": "node src/planning/effort-estimator.js",
    "backup:before": "node src/utils/backup-manager.js --create",
    "backup:restore": "node src/utils/backup-manager.js --restore",
    "metrics:baseline": "node src/utils/metrics-collector.js --baseline",
    "metrics:validate": "node src/utils/metrics-collector.js --validate",
    "monitor:check": "node src/validation/monitoring-check.js",
    "security:scan": "node src/security/scan-validator.js",
    "docs:validate": "node src/validation/documentation-validator.js",
    "pre-commit": "npm run validate:quality && npm run validate:refactor && npm run docs:validate",
    "quality-gate": "npm run validate:gates",
    "compliance:check": "node src/validation/refactor-validator.js --scope=all",
    "status:phase": "node src/execution/progress-monitor.js --current",
    "report:generate": "node src/utils/report-generator.js",
    "setup:complete": "npm install && npm run validate:preparation && echo 'Setup Complete - Ready for Phase 1'"
  },
  "keywords": [
    "refactor",
    "skills-fabrik",
    "tdd",
    "quality-gates",
    "risk-management",
    "architecture"
  ],
  "author": "Refactor Preparation Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "local"
  },
  "directories": {
    "doc": "dev-docs",
    "test": "tests",
    "lib": "src"
  }
}
