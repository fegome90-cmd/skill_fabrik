{
  "name": "code-quality-upgrade",
  "version": "1.0.0",
  "description": "Zero Technical Debt - Code Quality Unification",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ test/ scripts/ --ext .ts,.js",
    "lint:fix": "eslint src/ test/ scripts/ --ext .ts,.js --fix",
    "format": "prettier --write src/ test/ scripts/",
    "format:check": "prettier --check src/ test/ scripts/",
    "quality:check": "npm run lint && npm run format:check && npm test",
    "validate:task": "tsx scripts/validate-task-execution.ts",
    "dev": "concurrently \"npm run build:watch\" \"npm run test:watch\"",
    "backup:configs": "bash scripts/backup-configs.sh",
    "rollback:configs": "bash scripts/rollback-configs.sh",
    "migrate:unified": "bash scripts/migrate-to-unified.sh",
    "tsx": "tsx"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sonarjs": "^0.20.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "code-quality",
    "zero-debt",
    "clean-architecture",
    "tdd",
    "eslint",
    "prettier"
  ],
  "author": "Code Quality Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
