{
  "version": "2.0",
  "title": "Code Quality Upgrade Rules",
  "overview": "Este archivo contiene las reglas específicas para guiar el trabajo de agentes en la unificación de configuraciones de code quality, eliminando la deuda técnica mediante Clean Architecture y TDD.",
  
  "coreRules": {
    "taskExecution": {
      "maxDuration": 120,
      "maxSubtasks": 8,
      "tddMandatory": true,
      "cleanArchitecture": true,
      "testCoverage": 80,
      "documentation": true,
      "criticalRule": "NEVER_CONTINUE_ON_BROKEN_QUALITY_GATES"
    },
    
    "fileOrganization": {
      "noMagicNumbers": true,
      "noHardcodedValues": true,
      "noConsoleLogs": true,
      "namingConventions": {
        "variables": "camelCase",
        "classes": "PascalCase",
        "indentation": "2 spaces"
      }
    },
    
    "codeQualityGates": {
      "typeScriptZeroErrors": true,
      "eslintCompilationErrors": true, 
      "functionalityTests": true,
      "validationSystem": true,
      "performance": 3,
      "tests": true,
      "validationTruthfulness": true,
      "falsePositivePrevention": true,
      "earlyFailureDetection": true,
      "qualityGateReliability": 100,
      "blockingVsCosmetic": true
    },
    
    "architectureCompliance": {
      "singleResponsibility": true,
      "dependencyInversion": true,
      "interfaceSegregation": true,
      "openClosed": true,
      "compositionOverInheritance": true,
      "noCircularDependencies": true
    },
    
    "testingRequirements": {
      "redPhase": true,
      "greenPhase": true,
      "refactorPhase": true,
      "coverage": {
        "unit": 90,
        "integration": 80,
        "e2e": 70
      },
      "mockUsage": true,
      "testNaming": true
    },
    
    "securityRules": {
      "noSecrets": true,
      "noHardcodedCredentials": true,
      "inputValidation": true,
      "secureFileOperations": true,
      "secureCommandExecution": true,
      "encodingValidation": "UTF-8"
    },
    
    "performanceRequirements": {
      "maxExecutionTime": 300,
      "maxMemoryUsage": 512,
      "cacheConfiguration": true,
      "parallelExecution": true,
      "progressiveEnhancement": true
    },
    
    "documentationRequirements": {
      "codeComments": true,
      "apiDocumentation": true,
      "migrationGuide": true,
      "developerGuidelines": true,
      "troubleshooting": true,
      "readmeUpdated": true
    },
    
    "migrationSafety": {
      "backupBeforeChanges": true,
      "rollbackMechanism": true,
      "gradualRollout": true,
      "validationAfterEachStep": true,
      "versionControl": true,
      "validationSystemIntegrity": true,
      "qualityGateVerification": true,
      "stopOnBrokenValidation": true,
      "investigateQualityGateFailures": true
    }
  },
  
  "phases": [
    {
      "phase": 0,
      "name": "Setup",
      "hours": 16,
      "successCriteria": [
        "TDD framework configurado",
        "Estructura de proyecto creada",
        "Dependencias instaladas",
        "CI/CD pipeline funcionando"
      ]
    },
    {
      "phase": 1,
      "name": "Fundamentals", 
      "hours": 30,
      "successCriteria": [
        "ESLint configuration unificada",
        "Prettier configuration unificada",
        "Scripts de migración creados",
        "Documentación completa"
      ]
    },
    {
      "phase": 2,
      "name": "Quality Gates",
      "hours": 35,
      "successCriteria": [
        "Quality gates core implementados",
        "Husky hooks migrados",
        "Integration tests pasando",
        "Performance benchmarks cumplidos"
      ]
    },
    {
      "phase": 3,
      "name": "Advanced Scripts",
      "hours": 35,
      "successCriteria": [
        "Evidence validation scripts",
        "Metrics consistency scripts",
        "Quality gates orchestration",
        "Migration automation completa"
      ]
    },
    {
      "phase": 4,
      "name": "Validation",
      "hours": 20,
      "successCriteria": [
        "E2E tests pasando",
        "Performance optimizado",
        "Team training completo",
        "Zero technical debt achieved"
      ]
    }
  ],
  
  "qualityMetrics": {
    "configurationConsistency": 100,
    "testCoverage": 90,
    "performanceImprovement": 50,
    "technicalDebt": 0,
    "teamAdoption": 100
  },
  
  "criticalRules": {
    "neverContinueOnBrokenQualityGates": {
      "description": "Siempre detenerse cuando los quality gates tienen falsos positivos o errores de validación",
      "action": "Investigar y reparar sistemas de validación antes de continuar cualquier tarea",
      "examples": [
        "Validaciones pasan falsamente pero hay errores reales",
        "Dependencies checker lanza errores undefined", 
        "Config files tienen formato incorrecto",
        "ES modules vs CommonJS conflicts"
      ]
    },
    "validationTruthfulness": {
      "description": "Las validaciones deben ser 100% confiables antes de confiar en ellas",
      "action": "Verificar que cada validación realmente chequea lo que dice"
    },
    "earlyFailureDetection": {
      "description": "Detectar y corregir problemas estructurales lo antes posible", 
      "action": "Investigar inconsistencias inmediatamente"
    }
  },
  
    "agentGuidelines": {
      "taskExecution": {
        "workInChunks": true,
        "commitFrequently": true,
        "testAfterChanges": true,
        "documentDecisions": true,
        "typeScriptFirst": true,
        "blockOnError": true
      },
      "problemSolving": {
        "identifyRootCause": true,
        "proposeMultipleSolutions": true,
        "validateSolutions": true,
        "documentTradeoffs": true,
        "efficiencyFocus": true
      },
      "qualityAssurance": {
        "selfReviewRequired": true,
        "peerReviewCritical": true,
        "automatedValidation": true,
        "continuousImprovement": true,
        "testValidationSystemsFirst": true,
        "verifyQualityGateIntegrity": true,
        "stopOnValidationFailures": true,
        "investigateBeforeProceeding": true,
        "distinguishBlockingVsCosmetic": true
      }
    },  "deliverables": {
    "code": [
      "src/config/eslint.config.ts",
      "src/config/prettier.config.ts",
      "src/gates/",
      "src/core/",
      "scripts/",
      "test/"
    ],
    "documentation": [
      "dev-docs/context.md",
      "dev-docs/plan.md", 
      "dev-docs/task.md",
      "docs/developer-guidelines.md",
      "docs/migration-guide.md"
    ],
    "validation": [
      "test/unit/",
      "test/integration/",
      "test/e2e/",
      "test/performance/",
      "test/security/"
    ]
  }
}