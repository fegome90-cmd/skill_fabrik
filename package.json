{
  "name": "skills-fabrik",
  "version": "0.1.0",
  "description": "Skills Fabric - Sistema de gestión de Skills con CLOOP methodology",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @skills-fabrik/skills-cli build && pnpm --filter @skills-fabrik/router build",
    "dev": "pnpm --filter @skills-fabrik/skills-cli dev",
    "test": "pnpm --filter @skills-fabrik/skills-cli test",
    "test:integration": "bash packages/skills-cli/test/integration/run-tests.sh",
    "test:skills": "bash packages/skills-cli/test/integration/run-tests.sh skills",
    "test:plan": "bash packages/skills-cli/test/integration/run-tests.sh plan",
    "test:kpi": "bash packages/skills-cli/test/integration/run-tests.sh kpi",
    "test:visual": "bash packages/skills-cli/test/integration/run-tests.sh visual",
    "test:workflows": "bash packages/skills-cli/test/integration/run-tests.sh workflows",
    "test:skill-rules-schema": "node --test packages/skills-cli/test/skill-rules.schema.spec.mjs",
    "test:activation-cases": "pnpm --filter @skills-fabrik/router build && node --test packages/router/dist/__tests__/activation-cases.spec.js",
    "kpi:rollup": "node scripts/kpi/rollup.mjs",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "format": "prettier --write .",
    "gates": "bash scripts/devops/gates-runner.sh",
    "prepare": "husky install",
    "pr": "bash scripts/devops/create-pr.sh",
    "gh-setup": "bash scripts/devops/gh-setup.sh",
    "skills:index": "node packages/skills-cli/dist/index.js skills index ./skills --out ./registry/index.json",
    "skills:lint": "node packages/skills-cli/dist/index.js skills lint ./skills --strict",
    "skills:rules": "node packages/skills-cli/dist/index.js skills rules",
    "router:build": "pnpm --filter @skills-fabrik/router run build",
    "e2e": "pnpm router:build && node --loader ts-node/esm packages/router/e2e/simulate.ts || (echo '⚠️  ts-node not found. Install: pnpm add -D ts-node typescript' && exit 1)",
    "test:phase3": "bash scripts/tests/run-phase3-tests.sh",
    "test:phase3-quick": "pnpm -w build && pnpm skills:lint --strict && node -e \"require('./configs/skill-rules.json'); console.log('✅ Schema válido')\"",
    "test:chaos:auto-recovery": "node scripts/tests/run-chaos-auto-recovery-test.cjs",
    "test:chaos:enhanced": "cd packages/skills-cli && node test/chaos/enhanced-chaos-test.cjs",
    "test:security:optimize": "node scripts/tests/test-simple-security-optimization.cjs",
    "test:boundary:enhanced": "node scripts/tests/test-enhanced-boundary-testing-simple.cjs",
    "test:e2e:scale": "node scripts/tests/test-e2e-scale-simple.cjs",
    "test:chaos:dashboard": "node scripts/tests/test-chaos-dashboard.cjs",
    "test:performance:optimized": "node scripts/tests/test-performance-optimized-suite.cjs",
    "monitoring:dashboard": "node scripts/monitoring/enterprise-monitoring-dashboard.cjs",
    "production:readiness": "node scripts/automation/production-readiness-automation.cjs",
    "docs:generate": "node scripts/documentation/enterprise-documentation-generator-fixed.cjs",
    "guard:devdocs": "DOCOPS_WARN_ONLY=1 node scripts/dev-docs-guard.mjs dev/daemon-infalible-sprint",
    "smoke:health": "node scripts/smoke-health.mjs",
    "smoke:discovery": "node scripts/smoke-discovery.mjs",
    "smoke:redis": "node scripts/smoke-redis.mjs",
    "pre:operate": "pnpm guard:devdocs && pnpm smoke:health && (pnpm smoke:redis || true)",
    "triada:update": "node scripts/update-triada.mjs",
    "smoke:pg": "node scripts/smoke-pg.mjs",
    "snapshot:activate": "node scripts/snapshot-activate.mjs",
    "test:snapshot": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/snapshot.activate.spec.mjs",
    "test:schema": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/schema.activate.spec.mjs",
    "test:policy:deny": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/policy.deny.spec.mjs",
    "test:policy:allow": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/policy.allow.spec.mjs",
    "snapshot:execute": "node scripts/snapshot-execute.mjs",
    "test:snapshot:execute": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/snapshot.execute.spec.mjs",
    "f2:close": "node scripts/close-f2.mjs",
    "f3:close": "node scripts/close-f3.mjs",
    "test:pack": "node --test packages/skills-cli/test/pack.spec.mjs",
    "test:pack:det": "node --test packages/skills-cli/test/pack.determinism.spec.mjs",
    "test:verify": "node --test packages/skills-cli/test/verify.spec.mjs",
    "test:install": "node --test packages/skills-cli/test/install.spec.mjs",
    "test:manifest:schema": "node --test packages/skills-cli/test/manifest.schema.spec.mjs",
    "test:confirm:inline": "node --test packages/skills-cli/test/confirm.inline.spec.mjs",
    "test:metrics": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/metrics.spec.mjs",
    "test:resilience": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/resilience/*.spec.mjs",
    "test:daemon:smoke": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_ENABLED=false SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/health.smoke.spec.mjs",
    "test:daemon:activate": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/activate.boost.spec.mjs",
    "test:daemon:auth": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/auth.apikey.spec.mjs",
    "test:daemon:auth:jwt": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/auth.jwt.spec.mjs",
    "test:daemon:client": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/client/daemon-client.spec.mjs",
    "test:daemon:state": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/state/distributed-state.spec.mjs",
    "test:daemon:events": "pnpm --filter @skills-fabrik/daemon build && SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/persistence/event-store.spec.mjs",
    "test:policy:s1": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/policy.s1.spec.mjs",
    "test:policy:s2": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/policy.s2.spec.mjs",
    "test:policy:net": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/policy.net.spec.mjs",
    "test:policy:levels": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/policy.levels.spec.mjs",
    "test:confirm:s1:challenge": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/confirm.s1.challenge.spec.mjs",
    "test:confirm:s1:badtoken": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/confirm.s1.badtoken.spec.mjs",
    "test:confirm:s1:ok": "SF_DASHBOARD_PORT=0 SF_DASHBOARD_WS_PORT=0 node --test packages/daemon/test/confirm.s1.ok.spec.mjs",
    "pack:sample": "node packages/skills-cli/dist/index.js skills pack skills/repo-auditor --out ./.registry",
    "verify:sample": "pnpm run pack:sample && node packages/skills-cli/dist/index.js skills verify ./.registry/repo-auditor-0.1.0.tgz",
    "install:sample": "pnpm run verify:sample && node packages/skills-cli/dist/index.js skills install file://./.registry/repo-auditor-0.1.0.tgz --target ./.skills-installed --force",
    "f4:check": "pnpm test:pack && pnpm test:verify && pnpm test:install && pnpm test:pack:det && pnpm test:manifest:schema",
    "f4:close": "node scripts/close-f4.mjs",
    "f5:close": "node scripts/close-f5.mjs",
    "smoke:metrics": "node scripts/smoke-metrics.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "build:all": "pnpm clean && pnpm -w build",
    "pretest": "node scripts/guard-stale-dist.mjs",
    "pretest:metrics": "node scripts/guard-stale-dist.mjs",
    "pretest:confirm:s1:challenge": "node scripts/guard-stale-dist.mjs",
    "pretest:confirm:s1:badtoken": "node scripts/guard-stale-dist.mjs",
    "pretest:confirm:s1:ok": "node scripts/guard-stale-dist.mjs",
    "pretest:confirm:inline": "node scripts/guard-stale-dist.mjs",
    "pretest:pack": "node scripts/guard-stale-dist.mjs",
    "pretest:verify": "node scripts/guard-stale-dist.mjs",
    "pretest:install": "node scripts/guard-stale-dist.mjs",
    "pretest:pack:det": "node scripts/guard-stale-dist.mjs",
    "pretest:manifest:schema": "node scripts/guard-stale-dist.mjs",
    "f6:close": "node scripts/close-f6.mjs",
    "pb2:track": "node scripts/metrics/pb2-track.mjs",
    "pb2:report": "node scripts/metrics/pb2-report.mjs",
    "pb2:smoke": "node scripts/datasets/pb2-smoke.mjs",
    "pb2:vs:daemon": "node scripts/metrics/pb2-vs-daemon.mjs",
    "pb2:assert:p1": "node scripts/metrics/pb2-assert.mjs --file dev/agent-dev-docs/p1-assert.json",
    "pb2:batch": "node scripts/metrics/pb2-batch.mjs",
    "pb2:daily": "node scripts/metrics/pb2-daily.mjs",
    "pb2:signals": "node scripts/metrics/pb2-signals.mjs",
    "activate:batch": "node scripts/metrics/activate-batch.mjs",
    "activate:report": "node scripts/metrics/activate-report.mjs",
    "activate:sweep": "node scripts/metrics/activate-sweep.mjs",
    "activate:select": "node scripts/metrics/activate-select.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0",
  "bin": {
    "sf": "packages/skills-cli/dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@types/pg": "^8.16.0",
    "pg": "^8.17.0",
    "undici": "^7.18.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  }
}
