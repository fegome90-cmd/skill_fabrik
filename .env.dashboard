# Dashboard configuration
SF_DASHBOARD_ENABLED=true
SF_DASHBOARD_PORT=8888
SF_DASHBOARD_WS_PORT=8889

# Other daemon config (minimal for testing)
SF_HOST=127.0.0.1
SF_PORT=7727
SF_ENDPOINT=http://127.0.0.1:7727
SF_LOG_LEVEL=info
SF_STORAGE_L0=.sf
SF_STORAGE_L1=.sf/cache
CONFIRM_SECRET=test_dashboard_secret_32_chars_long

# Database (optional for dashboard testing)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sf_user
PG_PASSWORD=sf_pass
PG_DATABASE=sf_db

NODE_ENV=development
LOG_LEVEL=info