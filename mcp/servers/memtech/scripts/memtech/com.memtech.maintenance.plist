<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memtech.maintenance</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/felipe/Developer/startkit-main/packages/memtech-mcp/scripts/memtech/memtech-maintenance.mjs</string>
        <string>--full</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/felipe/Developer/startkit-main/packages/memtech-mcp</string>
    
    <key>StandardOutPath</key>
    <string>/Users/felipe/Developer/backups/logs/memtech-maintenance.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/felipe/Developer/backups/logs/memtech-maintenance.error.log</string>
    
    <key>RunAtLoad</key>
    <false/>
    
    <!-- Ejecutar cada 6 horas -->
    <key>StartInterval</key>
    <integer>21600</integer>
    
    <!-- También ejecutar a horas específicas -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>2</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>
    
    <key>KeepAlive</key>
    <false/>
    
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
