<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memtech.metrics</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/felipe/Developer/startkit-main/packages/memtech-mcp/scripts/memtech/metrics-exporter.mjs</string>
        <string>--once</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/felipe/Developer/startkit-main/packages/memtech-mcp</string>
    
    <key>StandardOutPath</key>
    <string>/Users/felipe/Developer/backups/logs/memtech-metrics.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/felipe/Developer/backups/logs/memtech-metrics.error.log</string>
    
    <key>RunAtLoad</key>
    <false/>
    
    <!-- Ejecutar cada 5 minutos -->
    <key>StartInterval</key>
    <integer>300</integer>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>
    
    <key>KeepAlive</key>
    <false/>
    
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
