{
  "version": "2.0.0",
  "updated": "2025-11-03",
  "description": "PBv2 Hook System - 3-Stage Pipeline Integration",
  "userPromptSubmit": {
    "enabled": true,
    "scriptPath": "scripts/hooks/pre-invoke.mjs",
    "skillRulesPath": "registry/index.json",
    "threshold": 0.45,
    "maxSkills": 7,
    "fuzzyMatch": true,
    "fuzzyThreshold": 0.7,
    "contextualBoost": true,
    "historyReuse": true,
    "historySize": 50,
    "boostFactors": {
      "fileContext": 0.15,
      "recentActivation": 0.10,
      "keywordDensity": 0.05,
      "intentMatch": 0.12
    },
    "pbv2Integration": {
      "enabled": true,
      "planDetection": {
        "enabled": true,
        "scriptPath": "scripts/hooks/plan-detector.mjs",
        "patterns": {
          "strong": [
            "/\\[Layout\\]/i",
            "/Clarify.*Layout.*Operate/i",
            "/\\[\\w+\\].*Plan/i"
          ],
          "contextual": ["^## Plan/i", "^### Objetivos/i"]
        },
        "minStructure": {
          "minBulletPoints": 2,
          "requireCLOOP": false
        },
        "cache": {
          "enabled": true,
          "maxSize": 100,
          "ttlMinutes": 60
        }
      }
    }
  },
  "stop": {
    "enabled": true,
    "scriptPath": "scripts/hooks/stop.mjs",
    "buildCheck": true,
    "lint": true,
    "prettier": true,
    "kpiEmit": true,
    "kpiThreshold": 0.8,
    "pbv2Integration": {
      "enabled": true,
      "scriptPath": "scripts/hooks/pbv2-integration.mjs",
      "activatorPath": "scripts/hooks/pbv2-activator.mjs",
      "processOutput": true,
      "savePlans": true,
      "outputPath": "dev/plans/auto-plan-{id}-{timestamp}.json"
    },
    "notifications": {
      "enabled": true,
      "onSuccess": true,
      "onWarning": true,
      "onError": true,
      "scriptPath": "scripts/hooks/notify.sh"
    },
    "bashValidator": {
      "enabled": true,
      "scriptPath": "scripts/hooks/bash-validator.py",
      "blockLevel": "error",
      "warnLevel": "warning"
    },
    "securityValidation": {
      "enabled": true,
      "sqlInjectionCheck": true,
      "xssCheck": true,
      "pathTraversalCheck": true,
      "commandInjectionCheck": true
    }
  },
  "pbv2Activator": {
    "enabled": true,
    "scriptPath": "scripts/hooks/pbv2-activator.mjs",
    "defaultComplexity": "medium",
    "includeFiles": "auto",
    "includeTemplate": true,
    "includeTags": true,
    "timeoutMs": 5000,
    "fastMode": {
      "enabled": true,
      "repoSizeThreshold": "medium"
    },
    "modes": {
      "logOnly": {
        "description": "Solo detecta y guarda, sin mostrar UI",
        "default": true
      },
      "onDemand": {
        "description": "Pregunta al usuario antes de activar",
        "default": false
      },
      "auto": {
        "description": "Activa automáticamente (solo para power users)",
        "default": false
      }
    },
    "debounceMs": 2000
  },
  "testingFramework": {
    "enabled": true,
    "testSuites": [
      "plan-detector-edge-tests.mjs",
      "pbv2-activator-unit-tests.mjs",
      "config-loader-unit-tests.mjs",
      "integration-tests.mjs",
      "pbv2-load-tests.mjs",
      "pbv2-robustness-tests.mjs",
      "pbv2-security-tests.mjs",
      "pbv2-claude-integration-tests.mjs"
    ],
    "totalTests": 138,
    "successRate": 0.904,
    "securityTestsPassed": 10
  }
}
