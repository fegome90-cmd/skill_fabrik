.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
.env.testing
.env.dashboard
.env.check

# Keep example files only
!.env.example
!.env.*.example

# Credential files
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
