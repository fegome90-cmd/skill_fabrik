{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-manifest.schema.json",
  "type": "object",
  "required": ["id", "version", "name", "hash", "createdAt", "allowed-tools"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "allowed-tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "scripts": {
      "type": "object",
      "properties": {
        "run": { "type": "string" },
        "dry-run": { "type": "string" }
      },
      "additionalProperties": false,
      "default": {}
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
